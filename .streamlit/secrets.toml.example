# Streamlit secrets template for dibbs-bot.
#
# To enable the shared-password gate on the dashboard:
#
#   1. Copy this file to .streamlit/secrets.toml
#   2. Set dibbs_password to whatever you want to share with your friends
#   3. Keep the real secrets.toml out of git (it's already in .gitignore)
#
# On Streamlit Community Cloud, don't copy this file at all -- instead, open
# your app on share.streamlit.io, click "Settings -> Secrets", and paste the
# same content into the editor there.
#
# If this key is missing or empty, the dashboard runs with no password (the
# normal local-dev behavior).

dibbs_password = "change-me-to-something-private"
