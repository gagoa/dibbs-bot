# Copy this file to `.env` and fill in any values you want to override.
# Never commit a real `.env` file.

# --- Database ---
# Path to the SQLite database file. Default lives in ./data/dibbs.db
DIBBS_DB_PATH=data/dibbs.db

# --- Ingestion ---
# Folder watched for manually-downloaded RFQ files (CSV / HTML / TXT).
DIBBS_INBOX_DIR=scraper/sample_data

# --- Scraper ---
# Base URL for DIBBS searches. Override if DLA changes the endpoint.
DIBBS_BASE_URL=https://www.dibbs.bsm.dla.mil
# Polite delay between scraper requests (seconds).
DIBBS_SCRAPE_DELAY=2.0
# Optional User-Agent override for the scraper.
DIBBS_USER_AGENT=dibbs-bot/0.1 (local research tool)

# --- Logging ---
# DEBUG, INFO, WARNING, ERROR
DIBBS_LOG_LEVEL=INFO
DIBBS_LOG_FILE=logs/dibbs-bot.log

# --- Optional paid APIs (leave blank for free/local mode) ---
SAM_GOV_API_KEY=
